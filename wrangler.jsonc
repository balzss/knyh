{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knyh",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Serves the site on this domain. The zone must be on the same Cloudflare account.
  "routes": [{ "pattern": "konyha.bazsi.org", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    // The Worker handles these first; everything else is served as a static asset.
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knyh",
      "database_id": "33d069fa-537e-4467-aa56-9bc540c70589",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Access settings. See README for where to find these values.
  "vars": {
    "TEAM_DOMAIN": "bsaros.cloudflareaccess.com",
    "POLICY_AUD": "f71d8a0be3e292abf981008b1f8f2e288a8520dcef7c0d842329dcbe7fe556df"
  }
}
