{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knyh",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    // The Worker handles these first; everything else is served as a static asset.
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knyh",
      // Replace with the id printed by `npx wrangler d1 create knyh`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Access settings. See README for where to find these values.
  "vars": {
    "TEAM_DOMAIN": "",
    "POLICY_AUD": ""
  }
}
